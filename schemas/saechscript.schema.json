{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SächScript-Projekt",
  "type": "object",
  "required": ["eingabe", "ausgabe"],
  "properties": {
    "$schema": { "type": "string" },
    "eingabe": { "type": "string", "minLength": 1 },
    "ausgabe": { "type": "string", "minLength": 1 },
    "ziel": { "enum": ["ES2020", "ES2021", "ES2022", "ES2023", "ES2024", "ESNext"] },
    "streng": { "type": "boolean" },
    "sourceMaps": { "type": "boolean" }
  },
  "additionalProperties": false
}
